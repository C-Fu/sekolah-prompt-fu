# Sekolah Prompt-Fu — environment variables
#
# All player progress (stars, completed levels, sound settings) is stored in the
# browser via localStorage (FR-2), so no database, session or OAuth secrets are
# required to run the game. The legacy database, NextAuth, OAuth, S3 storage,
# AI-provider, media-generation and cron keys were removed in Phase 01 with owner
# approval (01-01-SUMMARY.md) alongside the code that read them.

# Canonical absolute site URL used to build metadata/canonical links.
# Defaults to https://sekolah-prompt-fu.example when unset (see src/lib/seo.ts).
NEXT_PUBLIC_SITE_URL="https://sekolah-prompt-fu.example"